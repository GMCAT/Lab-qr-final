generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Brand {
  id Int @id @default(autoincrement())
  name String @unique
  items Item[]
}
model Location {
  id Int @id @default(autoincrement())
  name String @unique
  items Item[]
}
model Status {
  id Int @id @default(autoincrement())
  name String @unique
  items Item[]
}
model Category {
  id Int @id @default(autoincrement())
  name String @unique
  items Item[]
}
model User {
  id Int @id @default(autoincrement())
  name String
  email String? @unique
  role String @default("user") // user, admin, super_admin
  password_hash String?
  registration_source String @default("self") // self, admin, super_admin, legacy
  verification_status String @default("verified") // pending, verified, suspended
  verified_at DateTime?
  verified_by_id Int?
  created_by_id Int?
  must_change_password Boolean @default(false)
  token_version Int @default(0)
  password_reset_token_hash String? @unique
  password_reset_expires_at DateTime?
  position String?
  department_lab String?
  birth_date DateTime?
  phone String?
  can_manage_items Boolean @default(false)
  can_manage_users Boolean @default(false)
  can_manage_brands Boolean @default(false)
  can_manage_locations Boolean @default(false)
  can_manage_categories Boolean @default(false)
  can_manage_statuses Boolean @default(false)
  can_manage_responsibles Boolean @default(false)
  can_approve_borrow Boolean @default(false)
  items Item[]
  audit_logs AuditLog[]

  @@index([registration_source])
  @@index([verification_status])
  @@index([password_reset_expires_at])
}

model AuditLog {
  id BigInt @id @default(autoincrement())
  actor_user_id Int?
  actor User? @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)
  actor_name String
  actor_role String?
  action String
  entity_type String
  entity_id String?
  route String
  http_method String
  http_status Int
  ip_address String?
  user_agent String?
  request_data Json?
  result_data Json?
  created_at DateTime @default(now())

  @@index([created_at])
  @@index([actor_user_id, created_at])
  @@index([action, created_at])
  @@index([entity_type, entity_id])
}
model Item {
  id String @id @default(uuid())
  asset_code String @unique
  name String
  model String?
  serial_no String?
  size String?
  note String?
  purchase_date DateTime?
  price Decimal? @db.Decimal(10,2)
  brand_id Int
  brand Brand @relation(fields: [brand_id], references: [id])
  location_id Int
  location Location @relation(fields: [location_id], references: [id])
  status_id Int
  status Status @relation(fields: [status_id], references: [id])
  responsible_id Int
  responsible User @relation(fields: [responsible_id], references: [id])
  category_id Int?
  category Category? @relation(fields: [category_id], references: [id])
  files ItemFile[]
  borrow_logs BorrowLog[]
  issue_reports IssueReport[]
  maintenance_jobs MaintenanceJob[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  archived_at DateTime?
  archived_by_id Int?
  @@index([asset_code])
  @@index([serial_no])
  @@index([archived_at])
}
model ItemFile {
  id Int @id @default(autoincrement())
  item_id String
  item Item @relation(fields: [item_id], references: [id], onDelete: Cascade)
  file_name String
  file_url String
  file_type String // IMAGE, MANUAL, DATASHEET, OTHER
  is_cover Boolean @default(false)
  sort_order Int @default(0)
  created_at DateTime @default(now())

  @@index([item_id])
  @@index([file_type])
}
model BorrowLog {
  id Int @id @default(autoincrement())
  request_sn String? @unique
  borrower_user_id Int?
  item_id String
  item Item @relation(fields: [item_id], references: [id], onDelete: Cascade)
  borrower_name String
  borrower_position String?
  borrow_date DateTime @default(now())
  expected_return_date DateTime?
  return_date DateTime?
  approver_name String? // ชื่อผู้อนุมัติที่ผู้ยืมกรอก/ระบุไว้
  approval_status String @default("pending") // pending, approved, rejected
  return_status String @default("not_requested") // not_requested, pending, completed, rejected, damaged
  return_requested_at DateTime?
  return_requested_by_id Int?
  return_note String?
  return_condition String?
  return_verified_at DateTime?
  return_verified_by_id Int?
  return_verified_by_name String?
  return_reject_reason String?
  closed_at DateTime?
  approved_at DateTime?
  approved_by_id Int?
  approved_by_name String?
  borrow_document_file_name String?
  borrow_document_file_url String?
  return_document_file_name String?
  return_document_file_url String?
  rejected_at DateTime?
  rejected_by_id Int?
  rejected_by_name String?
  reject_reason String?
  note String?
  status_history BorrowStatusHistory[]

  @@index([approval_status])
  @@index([return_status])
  @@index([request_sn])
  @@index([borrower_user_id])
  @@index([item_id, approval_status])
  @@index([item_id, return_status])
}

model BorrowStatusHistory {
  id Int @id @default(autoincrement())
  borrow_log_id Int
  borrow_log BorrowLog @relation(fields: [borrow_log_id], references: [id], onDelete: Cascade)
  event_type String
  from_status String?
  to_status String
  reason String?
  note String?
  changed_by_id Int?
  changed_by_name String
  changed_at DateTime @default(now())

  @@index([borrow_log_id, changed_at])
  @@index([event_type])
}

model IssueReport {
  id Int @id @default(autoincrement())
  issue_sn String @unique
  item_id String
  item Item @relation(fields: [item_id], references: [id], onDelete: Cascade)
  reporter_user_id Int
  reporter_name String
  issue_type String
  severity String
  description String
  status String @default("pending") // pending, confirmed, repair, rejected, resolved
  attachment_file_name String?
  attachment_file_url String?
  reviewed_by_id Int?
  reviewed_by_name String?
  reviewed_at DateTime?
  review_note String?
  reject_reason String?
  resolved_at DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  status_history IssueStatusHistory[]
  maintenance_jobs MaintenanceJob[]

  @@index([item_id, status])
  @@index([reporter_user_id])
  @@index([status, created_at])
}

model IssueStatusHistory {
  id Int @id @default(autoincrement())
  issue_report_id Int
  issue_report IssueReport @relation(fields: [issue_report_id], references: [id], onDelete: Cascade)
  event_type String
  from_status String?
  to_status String
  reason String?
  note String?
  changed_by_id Int?
  changed_by_name String
  changed_at DateTime @default(now())

  @@index([issue_report_id, changed_at])
  @@index([event_type])
}

model MaintenanceJob {
  id Int @id @default(autoincrement())
  work_sn String @unique
  item_id String
  item Item @relation(fields: [item_id], references: [id], onDelete: Cascade)
  issue_report_id Int?
  issue_report IssueReport? @relation(fields: [issue_report_id], references: [id], onDelete: SetNull)
  job_type String // repair, preventive, calibration, inspection
  status String @default("scheduled") // scheduled, in_progress, completed, cancelled
  title String
  description String?
  assigned_to_id Int?
  assigned_to_name String?
  provider_name String?
  provider_contact String?
  scheduled_start DateTime?
  due_date DateTime?
  started_at DateTime?
  completed_at DateTime?
  cancelled_at DateTime?
  cost Decimal? @db.Decimal(12,2)
  result String?
  next_due_date DateTime?
  created_by_id Int
  created_by_name String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  documents MaintenanceDocument[]
  status_history MaintenanceStatusHistory[]

  @@index([item_id, status])
  @@index([issue_report_id])
  @@index([job_type, status])
  @@index([next_due_date])
}

model MaintenanceDocument {
  id Int @id @default(autoincrement())
  maintenance_job_id Int
  maintenance_job MaintenanceJob @relation(fields: [maintenance_job_id], references: [id], onDelete: Cascade)
  file_name String
  file_url String
  document_type String @default("other") // work_order, quotation, invoice, certificate, photo, other
  uploaded_by_id Int?
  uploaded_by_name String
  created_at DateTime @default(now())

  @@index([maintenance_job_id, document_type])
}

model MaintenanceStatusHistory {
  id Int @id @default(autoincrement())
  maintenance_job_id Int
  maintenance_job MaintenanceJob @relation(fields: [maintenance_job_id], references: [id], onDelete: Cascade)
  event_type String
  from_status String?
  to_status String
  note String?
  changed_by_id Int?
  changed_by_name String
  changed_at DateTime @default(now())

  @@index([maintenance_job_id, changed_at])
  @@index([event_type])
}
